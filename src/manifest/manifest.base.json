{
  "manifest_version": 3,
  "name": "Webpage to ePub Book",
  "version": "0.0.1",
  "description": "Collect pages you're reading into a list and save them as one EPUB book.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webpage to ePub Book",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus",
    "storage",
    "unlimitedStorage"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
